{
  "manifest_version": 3,
  "name": "goylarpet",
  "version": "0.4.2",
  "minimum_chrome_version": "106",
  "description": "Add signed amounts to Portfolio, Cash and each period’s profit or loss in one Polymarket tab with this free local parody for Chrome",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "navigation.js" },
  "action": {
    "default_title": "goylarpet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
